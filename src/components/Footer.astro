---
import { brandFor } from '@/config/brand';
import { asLocale } from '@/i18n';
import { getPillars } from '@/data/pillars';
import { getSolutions } from '@/data/solutions';
import Logo from '@/components/Logo.astro';

const locale = asLocale(Astro.currentLocale);
const brand = brandFor(locale);
const prefix = locale === 'en' ? '/en' : '';

const cols =
  locale === 'en'
    ? [
        {
          title: 'Services',
          links: getPillars('en').map((p) => ({ label: p.name, href: `/en/servicios/${p.slug}` })),
        },
        {
          title: 'Company',
          links: [
            { label: 'The AI-augmented company', href: '/en/empresa-aumentada' },
            { label: 'Transformation scenarios', href: '/en/casos' },
            { label: 'Insights', href: '/en/ideas' },
            { label: 'Contact', href: '/en/contacto' },
          ],
        },
        {
          title: 'Solutions',
          links: getSolutions('en').map((s) => ({ label: s.eyebrow, href: `/en/soluciones/${s.slug}` })),
        },
      ]
    : [
        {
          title: 'Servicios',
          links: getPillars('es').map((p) => ({ label: p.name, href: `/servicios/${p.slug}` })),
        },
        {
          title: 'Empresa',
          links: [
            { label: 'Empresa aumentada por IA', href: '/empresa-aumentada' },
            { label: 'Escenarios de transformación', href: '/casos' },
            { label: 'Ideas', href: '/ideas' },
            { label: 'Contacto', href: '/contacto' },
          ],
        },
        {
          title: 'Soluciones',
          links: getSolutions('es').map((s) => ({ label: s.eyebrow, href: `/soluciones/${s.slug}` })),
        },
      ];

const legal =
  locale === 'en'
    ? { aviso: 'Legal notice', privacidad: 'Privacy', cookies: 'Cookies', consent: 'Manage consent', aria: 'Legal', home: 'home' }
    : { aviso: 'Aviso legal', privacidad: 'Privacidad', cookies: 'Cookies', consent: 'Gestionar consentimiento', aria: 'Legal', home: 'inicio' };
---

<footer class="dark">
  <div class="wrap">
    <div class="ft-top">
      <div class="ft-brand-col">
        <a href={prefix || '/'} class="ft-logo" aria-label={`${brand.name} — ${legal.home}`}>
          <Logo size={30} onDark />
        </a>
        <p class="ft-claim">{brand.claim}</p>
        <a href={brand.cta.href} class="btn btn-primary ft-cta">{brand.cta.labelShort}</a>
      </div>

      <div class="ft-cols">
        {
          cols.map((col) => (
            <div class="ft-col">
              <h3 class="ft-col-h">{col.title}</h3>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="ft-bottom">
      <p class="ft-copy">© {brand.year} {brand.name}. {brand.claim}</p>
      <nav class="ft-legal" aria-label={legal.aria}>
        <a href={`${prefix}/aviso-legal`}>{legal.aviso}</a>
        <a href={`${prefix}/privacidad`}>{legal.privacidad}</a>
        <a href={`${prefix}/cookies`}>{legal.cookies}</a>
        <button id="cgx-manage-consent" class="ft-consent">{legal.consent}</button>
        <a href={`mailto:${brand.email}`}>{brand.email}</a>
      </nav>
    </div>
  </div>
</footer>

<script>
  import { MANAGE_EVENT } from '@/scripts/consent';
  document.getElementById('cgx-manage-consent')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent(MANAGE_EVENT));
    // El banner es fijo al fondo de la ventana: subir el foco visual hasta él.
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
  });
</script>

<style>
  footer {
    padding: 72px 0 40px;
  }
  .ft-top {
    display: grid;
    grid-template-columns: 1.1fr 2fr;
    gap: 56px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--navy-line);
  }
  .ft-claim {
    color: var(--on-navy-2);
    font-size: 16px;
    line-height: 1.6;
    margin: 18px 0 24px;
    max-width: 280px;
  }
  .ft-cta {
    font-size: 14px;
  }
  .ft-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .ft-col-h {
    font-family: var(--head);
    font-size: 13px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 14px;
  }
  .ft-col li {
    margin-bottom: 10px;
  }
  .ft-col a {
    font-size: 14.5px;
    color: var(--on-navy-2);
    transition: color 0.2s;
  }
  .ft-col a:hover {
    color: var(--teal-2);
  }
  .ft-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 28px;
  }
  .ft-copy {
    font-size: 13px;
    color: var(--on-navy-2);
  }
  .ft-legal {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .ft-legal a {
    font-size: 13.5px;
    color: var(--on-navy-2);
    transition: color 0.2s;
  }
  .ft-legal a:hover {
    color: var(--teal-2);
  }
  /* Botón con aspecto de enlace legal: reabre el banner de consentimiento. */
  .ft-consent {
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--on-navy-2);
    transition: color 0.2s;
  }
  .ft-consent:hover {
    color: var(--teal-2);
  }
  @media (max-width: 820px) {
    .ft-top {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .ft-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .ft-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
