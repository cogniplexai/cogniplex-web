---
import { brand } from '@/config/brand';
import Logo from '@/components/Logo.astro';

const cols = [
  {
    title: 'Servicios',
    links: [
      { label: 'Fractional Leadership', href: '/servicios/fractional-leadership' },
      { label: 'Strategy & Design', href: '/servicios/strategy-design' },
      { label: 'Build & Transform', href: '/servicios/build-transform' },
      { label: 'Enablement & Adoption', href: '/servicios/enablement-adoption' },
      { label: 'Managed & Evolve', href: '/servicios/managed-evolve' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Empresa aumentada por IA', href: '/empresa-aumentada' },
      { label: 'Escenarios de transformación', href: '/casos' },
      { label: 'Ideas', href: '/ideas' },
      { label: 'Contacto', href: '/contacto' },
    ],
  },
  {
    title: 'Soluciones',
    links: [
      { label: 'Dirección de IA externa', href: '/soluciones/direccion-ia-externa' },
      { label: 'Automatización de procesos', href: '/soluciones/automatizacion-de-procesos' },
      { label: 'Formación transformativa', href: '/soluciones/formacion-transformativa' },
      { label: 'Gobierno de IA', href: '/soluciones/gobierno-de-ia' },
    ],
  },
];
---

<footer class="dark">
  <div class="wrap">
    <div class="ft-top">
      <div class="ft-brand-col">
        <a href="/" class="ft-logo" aria-label={`${brand.name} — inicio`}>
          <Logo size={30} onDark />
        </a>
        <p class="ft-claim">{brand.claim}</p>
        <a href={brand.cta.href} class="btn btn-primary ft-cta">{brand.cta.labelShort}</a>
      </div>

      <div class="ft-cols">
        {
          cols.map((col) => (
            <div class="ft-col">
              <h3 class="ft-col-h">{col.title}</h3>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="ft-bottom">
      <p class="ft-copy">© {brand.year} {brand.name}. {brand.claim}</p>
      <nav class="ft-legal" aria-label="Legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/cookies">Cookies</a>
        <a href={`mailto:${brand.email}`}>{brand.email}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 72px 0 40px;
  }
  .ft-top {
    display: grid;
    grid-template-columns: 1.1fr 2fr;
    gap: 56px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--navy-line);
  }
  .ft-claim {
    color: var(--on-navy-2);
    font-size: 16px;
    line-height: 1.6;
    margin: 18px 0 24px;
    max-width: 280px;
  }
  .ft-cta {
    font-size: 14px;
  }
  .ft-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .ft-col-h {
    font-family: var(--head);
    font-size: 13px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 14px;
  }
  .ft-col li {
    margin-bottom: 10px;
  }
  .ft-col a {
    font-size: 14.5px;
    color: var(--on-navy-2);
    transition: color 0.2s;
  }
  .ft-col a:hover {
    color: var(--teal-2);
  }
  .ft-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 28px;
  }
  .ft-copy {
    font-size: 13px;
    color: var(--on-navy-2);
  }
  .ft-legal {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .ft-legal a {
    font-size: 13.5px;
    color: var(--on-navy-2);
    transition: color 0.2s;
  }
  .ft-legal a:hover {
    color: var(--teal-2);
  }
  @media (max-width: 820px) {
    .ft-top {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .ft-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .ft-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
