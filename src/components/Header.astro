---
import { brandFor } from '@/config/brand';
import { asLocale, localizePath } from '@/i18n';
import Logo from '@/components/Logo.astro';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const brand = brandFor(locale);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href.replace(/\/$/, '') || current.startsWith(href.replace(/\/$/, '') + '/');
const esHref = localizePath(current, 'es');
const enHref = localizePath(current, 'en');
const homeHref = locale === 'en' ? '/en/' : '/';
---

<nav id="site-nav" class={transparent ? 'transparent' : 'opaque'} aria-label={locale === 'en' ? 'Main' : 'Principal'}>
  <div class="wrap nav-in">
    <a href={homeHref} class="nav-logo" aria-label={`${brand.name} — ${locale === 'en' ? 'home' : 'inicio'}`}>
      <Logo size={30} />
    </a>

    <button
      id="nav-toggle"
      class="nav-toggle"
      aria-label={locale === 'en' ? 'Open menu' : 'Abrir menú'}
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span></span><span></span><span></span>
    </button>

    <div id="nav-menu" class="nav-menu">
      <ul class="nav-links">
        {
          brand.nav.map((item) => (
            <li>
              <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="lang-switch" aria-label={locale === 'en' ? 'Language' : 'Idioma'}>
        <a href={esHref} class={locale === 'es' ? 'on' : ''} aria-current={locale === 'es' ? 'true' : undefined} lang="es" hreflang="es">ES</a>
        <span aria-hidden="true">·</span>
        <a href={enHref} class={locale === 'en' ? 'on' : ''} aria-current={locale === 'en' ? 'true' : undefined} lang="en" hreflang="en">EN</a>
      </div>
      <a href={brand.cta.href} class="nav-cta">{brand.cta.labelShort}</a>
    </div>
  </div>
</nav>

<style>
  #site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    min-height: var(--nav-h);
    z-index: 100;
    transition: background 0.25s, border-color 0.25s, box-shadow 0.25s;
    border-bottom: 1px solid transparent;
  }
  /* Sobre hero oscuro */
  #site-nav.transparent {
    background: transparent;
  }
  #site-nav.transparent :global(.logo-word),
  #site-nav.transparent .nav-links a {
    color: rgba(255, 255, 255, 0.86);
  }
  #site-nav.transparent .nav-links a:hover,
  #site-nav.transparent .nav-links a.active {
    color: #fff;
  }
  /* Opaca por defecto (páginas interiores) */
  #site-nav.opaque,
  #site-nav.solid {
    background: rgba(244, 246, 247, 0.94);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom-color: var(--line);
    box-shadow: 0 8px 30px -24px rgba(11, 31, 51, 0.5);
  }

  /* Al hacer scroll sobre el hero, la nav transparente pasa a fondo claro:
     el fondo y el texto deben volverse los "sólidos" (si no, quedaría texto
     blanco sobre fondo claro e ilegible). Selector compuesto para ganar
     especificidad a las reglas .transparent. */
  #site-nav.transparent.solid {
    background: rgba(244, 246, 247, 0.94);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom-color: var(--line);
    box-shadow: 0 8px 30px -24px rgba(11, 31, 51, 0.5);
  }
  #site-nav.transparent.solid :global(.logo-word) {
    color: var(--tx);
  }
  #site-nav.transparent.solid .nav-links a {
    color: var(--tx-2);
  }
  #site-nav.transparent.solid .nav-links a:hover,
  #site-nav.transparent.solid .nav-links a.active {
    color: var(--teal-deep);
  }
  #site-nav.transparent.solid .nav-toggle span {
    background: var(--tx);
  }

  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-h);
    /* La nav necesita más ancho que el contenido para que los 6 ítems
       quepan siempre en una sola línea (sin partir títulos). */
    max-width: 1240px;
  }
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-links a {
    font-size: 15px;
    font-weight: 500;
    color: var(--tx-2);
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--teal-deep);
  }
  .nav-cta {
    font-family: var(--head);
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: var(--teal);
    padding: 10px 18px;
    border-radius: 8px;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--teal-deep);
  }

  /* Selector de idioma: discreto, tipográfico */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--head);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: var(--tx-3);
  }
  .lang-switch a {
    color: var(--tx-3);
    transition: color 0.2s;
    padding: 4px 2px;
  }
  .lang-switch a:hover {
    color: var(--teal-deep);
  }
  .lang-switch a.on {
    color: var(--teal-deep);
    font-weight: 800;
  }
  #site-nav.transparent .lang-switch,
  #site-nav.transparent .lang-switch a {
    color: rgba(255, 255, 255, 0.55);
  }
  #site-nav.transparent .lang-switch a:hover {
    color: #fff;
  }
  #site-nav.transparent .lang-switch a.on {
    color: #fff;
  }
  #site-nav.transparent.solid .lang-switch,
  #site-nav.transparent.solid .lang-switch a {
    color: var(--tx-3);
  }
  #site-nav.transparent.solid .lang-switch a.on,
  #site-nav.transparent.solid .lang-switch a:hover {
    color: var(--teal-deep);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    padding: 8px;
  }
  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--tx);
    transition: background 0.2s;
  }
  #site-nav.transparent .nav-toggle span {
    background: #fff;
  }

  @media (max-width: 1150px) {
    .nav-toggle {
      display: flex;
    }
    .nav-menu {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      padding: 12px 22px 22px;
      box-shadow: 0 18px 40px -30px rgba(0, 0, 0, 0.4);
      display: none;
    }
    #site-nav.open .nav-menu {
      display: flex;
    }
    /* En móvil el menú siempre es sobre fondo claro */
    #site-nav.transparent.open {
      background: rgba(244, 246, 247, 0.96);
      backdrop-filter: blur(12px);
    }
    #site-nav.transparent.open :global(.logo-word) {
      color: var(--tx);
    }
    #site-nav.transparent.open .nav-toggle span {
      background: var(--tx);
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    #site-nav .nav-menu .nav-links a {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      color: var(--tx);
    }
    .nav-cta {
      margin-top: 16px;
      text-align: center;
    }
    .lang-switch {
      justify-content: center;
      padding: 14px 0 0;
    }
    #site-nav.transparent.open .lang-switch,
    #site-nav.transparent.open .lang-switch a {
      color: var(--tx-3);
    }
    #site-nav.transparent.open .lang-switch a.on {
      color: var(--teal-deep);
    }
  }
</style>
