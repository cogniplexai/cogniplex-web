---
/**
 * Motivo gráfico recurrente: nodos conectados (personas · datos · procesos).
 * Decorativo. Se usa como fondo suave de secciones o separador.
 * tone: 'teal' (sobre claro) | 'light' (sobre navy)
 */
interface Props {
  tone?: 'teal' | 'light';
  class?: string;
}
const { tone = 'teal', class: cls = '' } = Astro.props;
const stroke = tone === 'light' ? 'rgba(92,198,198,0.55)' : 'rgba(0,128,128,0.4)';
const dot = tone === 'light' ? '#5cc6c6' : '#338180';
const dotSoft = tone === 'light' ? '#3f8a8a' : '#75b7b6';
---

<svg
  class={`node-motif ${cls}`}
  viewBox="0 0 240 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g stroke={stroke} stroke-width="1">
    <line x1="40" y1="52" x2="120" y2="34" />
    <line x1="120" y1="34" x2="196" y2="70" />
    <line x1="40" y1="52" x2="86" y2="128" />
    <line x1="86" y1="128" x2="120" y2="34" />
    <line x1="86" y1="128" x2="168" y2="150" />
    <line x1="196" y1="70" x2="168" y2="150" />
    <line x1="120" y1="34" x2="196" y2="70" />
    <line x1="168" y1="150" x2="120" y2="34" />
  </g>
  <g>
    <circle cx="120" cy="34" r="11" fill={dot} />
    <circle cx="86" cy="128" r="14" fill={dot} />
    <circle cx="196" cy="70" r="9" fill={dotSoft} />
    <circle cx="168" cy="150" r="10" fill={dotSoft} />
    <circle cx="40" cy="52" r="7" fill={dotSoft} />
    <circle cx="212" cy="140" r="5" fill={dotSoft} />
    <circle cx="60" cy="170" r="5" fill={dotSoft} />
  </g>
</svg>

<style>
  .node-motif {
    width: 100%;
    height: auto;
  }
</style>
