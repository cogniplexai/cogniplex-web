---
import { brand } from '@/config/brand';
import AnimatedNodes from '@/components/AnimatedNodes.astro';

interface Props {
  title?: string;
  lead?: string;
  eyebrow?: string;
}
const {
  eyebrow = 'Empieza por aquí',
  title = 'Convierte la incertidumbre en una hoja de ruta',
  lead = 'El Diagnóstico Empresa Aumentada identifica dónde la IA, los datos y la automatización pueden generar valor real en tu empresa, y en qué orden abordarlo.',
} = Astro.props;
---

<section class="cta-final dark">
  <div class="cta-anim" aria-hidden="true"><AnimatedNodes density="soft" /></div>
  <div class="wrap cta-in fade-in">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="sec-h">{title}</h2>
    <p class="sec-lead">{lead}</p>
    <div class="cta-actions">
      <a href={brand.cta.href} class="btn btn-primary">{brand.cta.label}</a>
      <a href="/contacto" class="btn btn-light-ghost">Hablar con un experto</a>
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding: 100px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--navy-line);
  }
  .cta-anim {
    position: absolute;
    inset: 0;
    opacity: 0.7;
    pointer-events: none;
  }
  .cta-in {
    position: relative;
    max-width: 720px;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
  }
</style>
