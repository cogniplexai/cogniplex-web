---
import { brandFor } from '@/config/brand';
import { asLocale } from '@/i18n';
import AnimatedNodes from '@/components/AnimatedNodes.astro';

interface Props {
  title?: string;
  lead?: string;
  eyebrow?: string;
}
const locale = asLocale(Astro.currentLocale);
const brand = brandFor(locale);
const defaults =
  locale === 'en'
    ? {
        eyebrow: 'Start here',
        title: 'Turn uncertainty into a roadmap',
        lead: 'The Augmented Company Assessment identifies where AI, data and automation can create real value in your company, and in what order to tackle it.',
        talk: 'Talk to an expert',
        contactHref: '/en/contacto',
      }
    : {
        eyebrow: 'Empieza por aquí',
        title: 'Convierte la incertidumbre en una hoja de ruta',
        lead: 'El Diagnóstico Empresa Aumentada identifica dónde la IA, los datos y la automatización pueden generar valor real en tu empresa, y en qué orden abordarlo.',
        talk: 'Hablar con un experto',
        contactHref: '/contacto',
      };
const { eyebrow = defaults.eyebrow, title = defaults.title, lead = defaults.lead } = Astro.props;
---

<section class="cta-final dark">
  <div class="cta-anim" aria-hidden="true"><AnimatedNodes density="soft" /></div>
  <div class="wrap cta-in fade-in">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="sec-h">{title}</h2>
    <p class="sec-lead">{lead}</p>
    <div class="cta-actions">
      <a href={brand.cta.href} class="btn btn-primary">{brand.cta.label}</a>
      <a href={defaults.contactHref} class="btn btn-light-ghost">{defaults.talk}</a>
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding: 100px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--navy-line);
  }
  .cta-anim {
    position: absolute;
    inset: 0;
    opacity: 0.7;
    pointer-events: none;
  }
  .cta-in {
    position: relative;
    max-width: 720px;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 34px;
  }
</style>
