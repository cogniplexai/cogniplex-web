---
/**
 * Enjambre de nodos (SVG): cúmulos volumétricos de círculos teal.
 * Cada cúmulo es una esfera 3D real generada en build (núcleo denso, superficie
 * dispersa) y proyectada con perspectiva: el tamaño y la opacidad de cada
 * partícula dependen de su profundidad. La rotación 3D del cúmulo se precalcula
 * (posición proyectada en los dos extremos del giro) y CSS interpola entre ambas,
 * de modo que las partículas cercanas se desplazan más que las lejanas: paralaje
 * real sin JavaScript en runtime.
 * - Respeta prefers-reduced-motion (quedan los cúmulos estáticos, aún con volumen).
 * density: 'hero' (denso, portada) | 'soft' (sutil, CTA/interiores)
 */
interface Props {
  density?: 'hero' | 'soft';
  class?: string;
}
const { density = 'hero', class: cls = '' } = Astro.props;

/** PRNG con semilla: el enjambre es idéntico en cada build. */
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(density === 'hero' ? 20260704 : 8080);

const W = 1200;
const H = 800;
const F = 900; // distancia focal de la proyección en perspectiva
const palette = ['#5cc6c6', '#75b7b6', '#8fd4d3', '#3f8a8a', '#2e9d9c'];

type V3 = { x: number; y: number; z: number };

/** Rotación alrededor del eje Y (giro) y después del eje X (cabeceo suave). */
function rotate(p: V3, a: number, b: number): V3 {
  const x1 = p.x * Math.cos(a) + p.z * Math.sin(a);
  const z1 = -p.x * Math.sin(a) + p.z * Math.cos(a);
  const y2 = p.y * Math.cos(b) - z1 * Math.sin(b);
  const z2 = p.y * Math.sin(b) + z1 * Math.cos(b);
  return { x: x1, y: y2, z: z2 };
}

/** Proyección en perspectiva sobre el centro del cúmulo. */
function project(p: V3, cx: number, cy: number) {
  const s = F / (F + p.z);
  return { px: cx + p.x * s, py: cy + p.y * s, s };
}

interface ClusterSpec {
  cx: number;
  cy: number;
  R: number;
  n: number;
  swing: number; // amplitud total del giro (radianes)
  tilt: number; // cabeceo que acompaña al giro
  dur: number; // segundos por media oscilación
  dir: 1 | -1; // sentido del giro (alternamos para dar vida)
}

interface Particle {
  x: number;
  y: number;
  r: number;
  c: string;
  o: number;
  dx: number;
  dy: number;
  delay: number;
  m: number;
  mdur: number;
  tw: boolean;
}

function buildCluster(spec: ClusterSpec): Particle[] {
  const parts: Particle[] = [];
  for (let i = 0; i < spec.n; i++) {
    // Punto dentro de la esfera, con núcleo más denso y ligero achatado vertical
    const u = rnd() * 2 - 1;
    const phi = rnd() * Math.PI * 2;
    const rr = spec.R * Math.cbrt(rnd());
    const sq = Math.sqrt(1 - u * u);
    const p: V3 = {
      x: rr * sq * Math.cos(phi),
      y: rr * sq * Math.sin(phi) * 0.82,
      z: rr * u,
    };
    const half = (spec.swing / 2) * spec.dir;
    const a = project(rotate(p, -half, -spec.tilt / 2), spec.cx, spec.cy);
    const b = project(rotate(p, half, spec.tilt / 2), spec.cx, spec.cy);
    // Profundidad en el extremo inicial: cerca (z<0) → mayor y más opaco
    const zA = rotate(p, -half, -spec.tilt / 2).z;
    const t = (spec.R - zA) / (2 * spec.R); // 1 = delante, 0 = detrás
    const r = (1.3 + rnd() ** 2 * 5.5) * a.s;
    parts.push({
      x: +a.px.toFixed(1),
      y: +a.py.toFixed(1),
      r: +r.toFixed(1),
      c: palette[Math.floor(rnd() * palette.length)],
      o: +(0.3 + 0.62 * t).toFixed(2),
      dx: +(b.px - a.px).toFixed(1),
      dy: +(b.py - a.py).toFixed(1),
      delay: +(-spec.dur / 2 + (rnd() - 0.5) * 2.4).toFixed(1),
      m: Math.floor(rnd() * 3),
      mdur: +(6 + rnd() * 6).toFixed(1),
      tw: rnd() < 0.25 && t > 0.55,
    });
  }
  // De atrás a delante, para que las partículas cercanas pinten encima
  return parts.sort((p1, p2) => p2.o - p1.o).reverse();
}

/** Cúmulos a lo largo de la diagonal de marca (abajo-izda → arriba-dcha). */
const clusterSpecs: ClusterSpec[] =
  density === 'hero'
    ? [
        { cx: 935, cy: 255, R: 160, n: 58, swing: 0.5, tilt: 0.16, dur: 30, dir: 1 },
        { cx: 600, cy: 520, R: 115, n: 40, swing: 0.6, tilt: 0.2, dur: 24, dir: -1 },
        { cx: 315, cy: 655, R: 75, n: 22, swing: 0.7, tilt: 0.24, dur: 19, dir: 1 },
      ]
    : [
        { cx: 890, cy: 320, R: 120, n: 34, swing: 0.5, tilt: 0.16, dur: 28, dir: 1 },
        { cx: 420, cy: 540, R: 85, n: 24, swing: 0.6, tilt: 0.2, dur: 22, dir: -1 },
      ];

const clusters = clusterSpecs.map((spec) => ({
  dur: spec.dur,
  parts: buildCluster(spec),
}));

/** Polvo ambiental suelto: profundidad de campo alrededor de los cúmulos. */
const DUST = density === 'hero' ? 26 : 14;
const dust = Array.from({ length: DUST }, () => ({
  x: Math.round(rnd() * W),
  y: Math.round(rnd() * H),
  r: +(1 + rnd() ** 2 * 3).toFixed(1),
  c: palette[Math.floor(rnd() * palette.length)],
  o: +(0.14 + rnd() * 0.26).toFixed(2),
  m: Math.floor(rnd() * 3),
  dur: +(9 + rnd() * 9).toFixed(1),
  delay: +(-rnd() * 18).toFixed(1),
}));

/** Orbes de luz difusa en el corazón de cada cúmulo: volumen y resplandor. */
const orbs = clusterSpecs.map((spec) => ({
  x: spec.cx,
  y: spec.cy,
  r: Math.round(spec.R * 1.35),
  dur: +(30 + rnd() * 20).toFixed(1),
  delay: +(-rnd() * 30).toFixed(1),
}));
---

<svg
  class={`cx-swarm ${cls}`}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <radialGradient id="cx-orb-grad">
      <stop offset="0%" stop-color="#2e9d9c" stop-opacity="0.17"></stop>
      <stop offset="60%" stop-color="#2e9d9c" stop-opacity="0.06"></stop>
      <stop offset="100%" stop-color="#2e9d9c" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  {
    orbs.map((o) => (
      <circle
        class="cx-orb"
        cx={o.x}
        cy={o.y}
        r={o.r}
        fill="url(#cx-orb-grad)"
        style={`animation-duration:${o.dur}s;animation-delay:${o.delay}s`}
      />
    ))
  }

  {
    dust.map((d) => (
      <circle
        class={`cx-p cx-dust cx-micro-${d.m}`}
        cx={d.x}
        cy={d.y}
        r={d.r}
        fill={d.c}
        opacity={d.o}
        style={`animation-duration:${d.dur}s;animation-delay:${d.delay}s`}
      />
    ))
  }

  {
    clusters.map((cl) => (
      <g class="cx-cluster">
        {cl.parts.map((p) => (
          <g
            class="cx-rot"
            style={`--dx:${p.dx}px;--dy:${p.dy}px;animation-duration:${cl.dur}s;animation-delay:${p.delay}s`}
          >
            <circle
              class={`cx-p cx-micro-${p.m}${p.tw ? ' cx-twinkle' : ''}`}
              cx={p.x}
              cy={p.y}
              r={p.r}
              fill={p.c}
              opacity={p.o}
              style={`animation-duration:${p.mdur}s,${(p.mdur * 0.7).toFixed(1)}s;animation-delay:${p.delay}s,${p.delay}s`}
            />
          </g>
        ))}
      </g>
    ))
  }
</svg>

<style>
  .cx-swarm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  /* Rotación 3D del cúmulo: cada partícula viaja hasta su posición proyectada
     en el otro extremo del giro. Las cercanas recorren más que las lejanas. */
  .cx-rot {
    animation: cx-rot ease-in-out infinite alternate;
    animation-name: cx-rot;
  }
  @keyframes cx-rot {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(var(--dx), var(--dy));
    }
  }

  /* Deriva individual mínima: vida orgánica sin romper la forma del cúmulo */
  .cx-p {
    animation-name: cx-micro-0;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  .cx-micro-1 { animation-name: cx-micro-1; }
  .cx-micro-2 { animation-name: cx-micro-2; }

  /* El polvo ambiental deriva con más recorrido */
  .cx-dust.cx-micro-0 { animation-name: cx-dust-0; }
  .cx-dust.cx-micro-1 { animation-name: cx-dust-1; }
  .cx-dust.cx-micro-2 { animation-name: cx-dust-2; }

  /* Destello sutil en las partículas frontales (segunda animación: opacity) */
  .cx-twinkle { animation-name: cx-micro-0, cx-twinkle; }
  .cx-twinkle.cx-micro-1 { animation-name: cx-micro-1, cx-twinkle; }
  .cx-twinkle.cx-micro-2 { animation-name: cx-micro-2, cx-twinkle; }

  .cx-orb {
    animation: cx-orb ease-in-out infinite alternate;
  }

  @keyframes cx-micro-0 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(5px, -4px); }
    100% { transform: translate(-3px, 4px); }
  }
  @keyframes cx-micro-1 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-4px, 5px); }
    100% { transform: translate(4px, 2px); }
  }
  @keyframes cx-micro-2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(3px, 4px) scale(1.1); }
    100% { transform: translate(-4px, -3px) scale(0.94); }
  }
  @keyframes cx-dust-0 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(16px, -12px); }
    100% { transform: translate(-8px, 10px); }
  }
  @keyframes cx-dust-1 {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-14px, 12px); }
    100% { transform: translate(10px, -8px); }
  }
  @keyframes cx-dust-2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(11px, 14px) scale(1.12); }
    100% { transform: translate(-9px, -6px) scale(0.92); }
  }
  @keyframes cx-twinkle {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 0.95; }
  }
  @keyframes cx-orb {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-12px, 8px) scale(1.06); }
    100% { transform: translate(10px, -6px) scale(0.97); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cx-swarm :is(.cx-p, .cx-rot, .cx-orb) {
      animation: none !important;
    }
  }
</style>
