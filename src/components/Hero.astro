---
/**
 * Hero. variant:
 *  - 'home': full-bleed con foto editorial + overlay oscuro (para la portada).
 *  - 'interior': cabecera compacta sobre navy para páginas internas.
 */
import { brand } from '@/config/brand';
import NodeMotif from '@/components/NodeMotif.astro';

interface Props {
  variant?: 'home' | 'interior';
  eyebrow?: string;
  title: string;
  lead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  photo?: boolean;
}
const {
  variant = 'interior',
  eyebrow,
  title,
  lead,
  primaryCta = { label: brand.cta.label, href: brand.cta.href },
  secondaryCta,
  photo = variant === 'home',
} = Astro.props;
---

<section class={`hero hero-${variant}`} class:list={[{ 'has-photo': photo }]}>
  {!photo && <div class="motif-bg" aria-hidden="true"><NodeMotif tone="light" /></div>}
  <div class="wrap hero-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="hero-lead">{lead}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="hero-ctas">
          {primaryCta && (
            <a href={primaryCta.href} class="btn btn-primary">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-light-ghost">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy);
    color: #fff;
    overflow: hidden;
  }
  .hero-home {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-h) + 84px) 0 92px;
  }
  .hero-interior {
    padding: calc(var(--nav-h) + 72px) 0 76px;
  }
  .hero.has-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(
        110deg,
        rgba(9, 20, 34, 0.92) 0%,
        rgba(9, 20, 34, 0.82) 45%,
        rgba(9, 20, 34, 0.62) 100%
      ),
      url('/hero.jpg');
    background-size: cover;
    background-position: center;
  }
  .motif-bg {
    position: absolute;
    right: -30px;
    top: 46%;
    transform: translateY(-50%);
    width: 480px;
    max-width: 48%;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }
  .hero .eyebrow {
    color: var(--teal-2);
  }
  .hero h1 {
    font-family: var(--head);
    font-weight: 800;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: -1.4px;
    color: #fff;
    margin-bottom: 22px;
    max-width: 16ch;
  }
  .hero-interior h1 {
    max-width: 20ch;
    font-size: clamp(30px, 4.4vw, 46px);
  }
  .hero :global(h1 .em) {
    color: var(--teal-2);
  }
  .hero-lead {
    font-size: clamp(17px, 1.7vw, 20px);
    color: #cdd6e0;
    max-width: 620px;
    line-height: 1.7;
    margin-bottom: 34px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  @media (max-width: 760px) {
    .hero-home {
      min-height: auto;
      padding: calc(var(--nav-h) + 56px) 0 64px;
    }
    .motif-bg {
      display: none;
    }
  }
</style>
