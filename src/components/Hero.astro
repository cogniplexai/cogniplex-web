---
/**
 * Hero. variant:
 *  - 'home': portada a pantalla con red de nodos animada sobre navy.
 *  - 'interior': cabecera compacta con nodos animados sutiles.
 * photo: superpone la foto editorial (opcional, desactivada por defecto).
 */
import { brand } from '@/config/brand';
import AnimatedNodes from '@/components/AnimatedNodes.astro';

interface Props {
  variant?: 'home' | 'interior';
  eyebrow?: string;
  title: string;
  lead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  photo?: boolean;
}
const {
  variant = 'interior',
  eyebrow,
  title,
  lead,
  primaryCta = { label: brand.cta.label, href: brand.cta.href },
  secondaryCta,
  photo = false,
} = Astro.props;
---

<section class={`hero hero-${variant}`} class:list={[{ 'has-photo': photo }]}>
  <div class="hero-anim" aria-hidden="true">
    <AnimatedNodes density={variant === 'home' ? 'hero' : 'soft'} />
  </div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="wrap hero-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="hero-lead">{lead}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="hero-ctas">
          {primaryCta && (
            <a href={primaryCta.href} class="btn btn-primary">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-light-ghost">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(120% 120% at 80% 0%, #123049 0%, var(--navy) 55%),
      var(--navy);
    color: #fff;
    overflow: hidden;
  }
  .hero-home {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-h) + 84px) 0 92px;
  }
  .hero-interior {
    padding: calc(var(--nav-h) + 76px) 0 82px;
  }
  /* Foto opcional por encima del navy (si photo=true) */
  .hero.has-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(
        110deg,
        rgba(9, 20, 34, 0.94) 0%,
        rgba(9, 20, 34, 0.84) 45%,
        rgba(9, 20, 34, 0.66) 100%
      ),
      url('/hero.jpg');
    background-size: cover;
    background-position: center;
  }
  .hero-anim {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.9;
  }
  /* Halo teal para dar profundidad detrás del texto */
  .hero-glow {
    position: absolute;
    z-index: 0;
    right: -8%;
    top: 8%;
    width: 640px;
    height: 640px;
    max-width: 70%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 128, 128, 0.28) 0%, rgba(0, 128, 128, 0) 68%);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }
  .hero .eyebrow {
    color: var(--teal-2);
  }
  .hero h1 {
    font-family: var(--head);
    font-weight: 800;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: -1.4px;
    color: #fff;
    margin-bottom: 22px;
    max-width: 16ch;
  }
  .hero-interior h1 {
    max-width: 20ch;
    font-size: clamp(30px, 4.4vw, 46px);
  }
  .hero :global(h1 .em) {
    color: var(--teal-2);
  }
  .hero-lead {
    font-size: clamp(17px, 1.7vw, 20px);
    color: #cdd6e0;
    max-width: 620px;
    line-height: 1.7;
    margin-bottom: 34px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  @media (max-width: 760px) {
    .hero-home {
      min-height: auto;
      padding: calc(var(--nav-h) + 56px) 0 64px;
    }
    .hero-glow {
      width: 380px;
      height: 380px;
    }
  }
</style>
