---
import { siteFor } from '@/data/site';
import { asLocale } from '@/i18n';

const locale = asLocale(Astro.currentLocale);
const { marketProof } = siteFor(locale);
const copy =
  locale === 'en'
    ? {
        eyebrow: 'Why now',
        title: 'The opportunity is real. The difference lies in how you capture it.',
        lead: 'It is not just us saying it: the market context points to a concrete opportunity to apply AI to how the business is run. The advantage will not go to whoever tries more tools, but to whoever turns it into real capability first.',
        exampleTag: 'Illustrative example',
        example:
          'An advisory firm with a small team automates proposal drafting: it goes from sending a handful of offers a week to multiplying its capacity, without hiring more people and without losing its professional judgement.',
        credStrong: 'Our goal in every project is for the solution to pay for itself:',
        cred: 'for the value it creates to comfortably exceed what it costs. Every transformation starts from an impact hypothesis, a baseline and follow-up. We only publish verifiable results documented with the client’s permission.',
      }
    : {
        eyebrow: 'Por qué ahora',
        title: 'La oportunidad es real. La diferencia está en cómo se captura.',
        lead: 'No lo decimos solo nosotros: el contexto de mercado señala una oportunidad concreta de aplicar la IA a la gestión del negocio. La ventaja no será de quien pruebe más herramientas, sino de quien la convierta antes en capacidad real.',
        exampleTag: 'Ejemplo ilustrativo',
        example:
          'Una asesoría con un equipo reducido automatiza la elaboración de propuestas: pasa de enviar unas pocas ofertas a la semana a multiplicar su capacidad, sin contratar más personal y sin perder su criterio profesional.',
        credStrong: 'Nuestro objetivo en cada proyecto es que la solución se pague sola:',
        cred: 'que el valor que genera supere con holgura lo que cuesta. Toda transformación parte de una hipótesis de impacto, una línea base y un seguimiento. Solo publicamos resultados verificables y documentados con permiso del cliente.',
      };
---

<section class="block dark">
  <div class="wrap">
    <div class="block-hd fade-in">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="sec-h">{copy.title}</h2>
      <p class="sec-lead">{copy.lead}</p>
    </div>

    <div class="grid-3 stats fade-in">
      {
        marketProof.map((s) => (
          <div class="stat">
            <p class="stat-q">{s.stat}</p>
            <p class="stat-src">{s.source}</p>
          </div>
        ))
      }
    </div>

    <div class="cred-note fade-in">
      <span class="tag">{copy.exampleTag}</span>
      <p>{copy.example}</p>
    </div>

    <div class="cred-cases fade-in">
      <p class="cred-line">
        <strong>{copy.credStrong}</strong>
        {copy.cred}
      </p>
    </div>
  </div>
</section>

<style>
  .stat {
    background: var(--navy-2);
    border: 1px solid var(--navy-line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .stat-q {
    font-family: var(--head);
    font-weight: 600;
    font-size: 18px;
    color: #fff;
    line-height: 1.4;
    margin-bottom: 16px;
  }
  .stat-src {
    font-size: 13px;
    font-weight: 500;
    color: var(--on-navy-2);
  }
  .cred-note {
    background: rgba(0, 128, 128, 0.16);
    border-left: 3px solid var(--teal-2);
    border-radius: 4px;
    padding: 24px 28px;
    margin: 40px 0 32px;
  }
  .cred-note .tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--teal-2);
    display: block;
    margin-bottom: 8px;
  }
  .cred-note p {
    font-size: 16px;
    color: #d7dee6;
    line-height: 1.65;
  }
  .cred-line {
    font-size: 17px;
    color: var(--on-navy-2);
    line-height: 1.75;
    max-width: 760px;
    margin-bottom: 24px;
  }
  .cred-line strong {
    color: #fff;
    font-weight: 600;
  }
</style>
