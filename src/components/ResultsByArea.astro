---
import { siteFor } from '@/data/site';
import { asLocale } from '@/i18n';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const { resultsByArea } = siteFor(locale);
const copy =
  locale === 'en'
    ? {
        eyebrow: 'Outcomes by area',
        title: 'What changes in each part of your company',
        lead: 'An augmented company shows in the day-to-day: in every area, intelligence measurably expands what people can do.',
      }
    : {
        eyebrow: 'Resultados por área',
        title: 'Qué cambia en cada parte de tu empresa',
        lead: 'Una empresa aumentada se nota en el día a día: en cada área, la inteligencia amplía —de forma medible— la capacidad de las personas.',
      };
---

<section class:list={['block', 'results', { dark }]}>
  <div class="wrap">
    <div class="block-hd fade-in">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="sec-h">{copy.title}</h2>
      <p class="sec-lead">{copy.lead}</p>
    </div>
    <div class="results-list fade-in">
      {
        resultsByArea.map((r) => (
          <div class="result-row">
            <div class="result-area">{r.area}</div>
            <p class="result-text">{r.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .results-list {
    border-top: 1px solid var(--line);
  }
  .result-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .result-area {
    font-family: var(--head);
    font-weight: 700;
    font-size: 19px;
    color: var(--teal-deep);
  }
  .result-text {
    font-size: 16.5px;
    color: var(--tx-2);
    line-height: 1.65;
  }
  .results.dark .results-list,
  .results.dark .result-row {
    border-color: var(--navy-line);
  }
  .results.dark .result-area {
    color: var(--teal-2);
  }
  .results.dark .result-text {
    color: var(--on-navy-2);
  }
  @media (max-width: 700px) {
    .result-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
