---
import { pillars } from '@/data/pillars';
import PillarCard from '@/components/PillarCard.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
}
const {
  eyebrow = 'Portfolio',
  title = 'Un recorrido, no un catálogo',
  lead = 'Cinco pilares que acompañan a tu empresa desde comprender el problema hasta sostener el valor en el tiempo. Se entra por una necesidad concreta y se evoluciona hacia una relación estratégica.',
} = Astro.props;
---

<section class="block soft">
  <div class="wrap">
    <div class="block-hd fade-in">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="sec-h">{title}</h2>
      <p class="sec-lead">{lead}</p>
    </div>
    <div class="pillar-grid">
      {pillars.map((p) => <PillarCard pillar={p} />)}
    </div>
  </div>
</section>

<style>
  /* Flex centrado para que la última fila (5 pilares → 3+2) quede centrada. */
  .pillar-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }
  .pillar-grid :global(.pillar-card) {
    flex: 0 1 calc(33.333% - 16px);
  }
  @media (max-width: 980px) {
    .pillar-grid :global(.pillar-card) {
      flex-basis: calc(50% - 12px);
    }
  }
  @media (max-width: 680px) {
    .pillar-grid :global(.pillar-card) {
      flex-basis: 100%;
    }
  }
</style>
