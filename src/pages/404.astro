---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brand } from '@/config/brand';
---

<BaseLayout title="Página no encontrada" path="/404">
  <section class="nf">
    <div class="wrap nf-in">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="nf-lead">
        Puede que el enlace haya cambiado o que la página ya no esté disponible.
      </p>
      <div class="nf-ctas">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href={brand.cta.href} class="btn btn-ghost">{brand.cta.labelShort}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: calc(var(--nav-h) + 100px) 0 120px;
    text-align: center;
  }
  .nf-in {
    max-width: 560px;
  }
  .nf h1 {
    font-family: var(--head);
    font-weight: 800;
    font-size: clamp(32px, 5vw, 48px);
    letter-spacing: -1px;
    color: var(--tx);
    margin-bottom: 14px;
  }
  .nf-lead {
    font-size: 18px;
    color: var(--tx-2);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .nf .eyebrow {
    justify-content: center;
  }
  .nf-ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
