---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CaseCard from '@/components/CaseCard.astro';
import CTASection from '@/components/CTASection.astro';
import { outcomes } from '@/data/site';

const casos = (await getCollection('casos')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Escenarios de transformación"
  description="Cómo trabaja Cogniplex, explicado desde el problema, el proceso y el resultado. Escenarios de transformación empresarial con IA."
  path="/casos"
>
  <Hero
    variant="interior"
    eyebrow="Escenarios de transformación"
    title={`Resultados explicados desde el <span class="em">problema</span>, no desde la herramienta.`}
    lead="Cada escenario se cuenta desde la situación de partida, el proceso rediseñado y el resultado que buscamos. El cliente no compra agentes ni dashboards: compra capacidad, control, velocidad y aprendizaje. A medida que documentemos casos de cliente —con su permiso y con métricas verificables— los publicaremos aquí."
  />

  <section class="block">
    <div class="wrap">
      <div class="cases-grid">
        {
          casos.map((c) => (
            <CaseCard
              title={c.data.title}
              sector={c.data.sector}
              area={c.data.area}
              summary={c.data.summary}
              metric={c.data.metric}
              metricLabel={c.data.metricLabel}
              placeholder={c.data.placeholder}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Qué compra el cliente -->
  <section class="block soft">
    <div class="wrap">
      <div class="block-hd fade-in">
        <p class="eyebrow">Cómo medimos el impacto</p>
        <h2 class="sec-h">Cuatro resultados que buscamos en cada proyecto</h2>
      </div>
      <div class="grid-4">
        {
          outcomes.map((o) => (
            <div class="outcome fade-in">
              <h3>{o.name}</h3>
              <p>{o.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .outcome {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .outcome h3 {
    font-family: var(--head);
    font-weight: 700;
    font-size: 18px;
    color: var(--teal-deep);
    margin-bottom: 8px;
  }
  .outcome p {
    font-size: 15px;
    color: var(--tx-2);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
