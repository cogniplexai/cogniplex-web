---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GestionReserva from '@/components/GestionReserva.astro';
---

<BaseLayout
  title="Gestionar tu sesión"
  description="Cancela o reprograma tu sesión con Cogniplex."
  path="/sesion/gestion"
  noindex
>
  <section class="block dark sesion-block">
    <div class="wrap">
      <div class="sesion-cab">
        <p class="eyebrow">Sesión inicial · 30 minutos</p>
        <h1 class="sec-h">Gestionar tu sesión</h1>
      </div>
      <GestionReserva />
    </div>
  </section>
</BaseLayout>

<style>
  .sesion-block {
    min-height: calc(100vh - var(--nav-h));
    border-top: none;
  }
  .sesion-cab {
    max-width: 720px;
    margin-bottom: 36px;
  }
</style>
