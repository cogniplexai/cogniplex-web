---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CaseCard from '@/components/CaseCard.astro';
import CTASection from '@/components/CTASection.astro';
import { siteFor } from '@/data/site';

const casos = (await getCollection('casos'))
  .filter((c) => c.id.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);

const { outcomes } = siteFor('en');
---

<BaseLayout
  title="Transformation scenarios"
  description="How Cogniplex works, explained from the problem, the process and the result. Business transformation scenarios with AI."
  path="/casos"
>
  <Hero
    variant="interior"
    eyebrow="Transformation scenarios"
    title={`Results explained from the <span class="em">problem</span>, not from the tool.`}
    lead="Each scenario is told from the starting situation, the redesigned process and the result we pursue. The client does not buy agents or dashboards: they buy capacity, control, speed and learning. As we document client cases — with their permission and with verifiable metrics — we will publish them here."
  />

  <section class="block">
    <div class="wrap">
      <div class="cases-grid">
        {
          casos.map((c) => (
            <CaseCard
              title={c.data.title}
              sector={c.data.sector}
              area={c.data.area}
              summary={c.data.summary}
              metric={c.data.metric}
              metricLabel={c.data.metricLabel}
              placeholder={c.data.placeholder}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- What the client buys -->
  <section class="block soft">
    <div class="wrap">
      <div class="block-hd fade-in">
        <p class="eyebrow">How we measure impact</p>
        <h2 class="sec-h">Four outcomes we pursue in every project</h2>
      </div>
      <div class="grid-4">
        {
          outcomes.map((o) => (
            <div class="outcome fade-in">
              <h3>{o.name}</h3>
              <p>{o.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .outcome {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .outcome h3 {
    font-family: var(--head);
    font-weight: 700;
    font-size: 18px;
    color: var(--teal-deep);
    margin-bottom: 8px;
  }
  .outcome p {
    font-size: 15px;
    color: var(--tx-2);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
