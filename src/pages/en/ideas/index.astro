---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CTASection from '@/components/CTASection.astro';

const posts = (await getCollection('ideas'))
  .filter((p) => !p.data.draft && p.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Insights"
  description="Business content for SME leadership: the augmented company, management and ROI, processes, adoption and AI governance."
  path="/ideas"
>
  <Hero
    variant="interior"
    eyebrow="Insights"
    title={`Content that helps you <span class="em">decide</span>, not content that advertises tools.`}
    lead="We write for managing directors and executive committees who need to understand how to change their company without getting lost in the technological noise."
  />

  <section class="block">
    <div class="wrap">
      <div class="posts">
        {
          posts.map((post) => (
            <a href={`/en/ideas/${post.id.replace(/^en\//, '')}`} class="post-card fade-in">
              <span class="post-pillar">{post.data.pillar}</span>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                {fmt(post.data.pubDate)}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Insights applied to your company"
    title="What if we brought this to your specific case?"
    lead="Every idea makes sense when applied to your business. Start with an Augmented Company Assessment."
  />
</BaseLayout>

<style>
  .posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .post-card:hover {
    border-color: var(--teal-line);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -30px rgba(0, 80, 80, 0.35);
  }
  .post-pillar {
    font-family: var(--head);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--teal-deep);
    background: var(--teal-soft);
    border-radius: 20px;
    padding: 4px 12px;
    align-self: flex-start;
  }
  .post-title {
    font-family: var(--head);
    font-weight: 700;
    font-size: 22px;
    color: var(--tx);
    line-height: 1.2;
  }
  .post-desc {
    font-size: 15.5px;
    color: var(--tx-2);
    line-height: 1.6;
  }
  .post-date {
    font-size: 13px;
    color: var(--tx-3);
    margin-top: auto;
  }
  @media (max-width: 760px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
