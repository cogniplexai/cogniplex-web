---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import CTASection from '@/components/CTASection.astro';

const posts = (await getCollection('ideas'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Ideas"
  description="Contenidos de negocio para dirección de pymes: empresa aumentada, dirección y ROI, procesos, adopción y gobierno de IA."
  path="/ideas"
>
  <Hero
    variant="interior"
    eyebrow="Ideas"
    title={`Contenido que ayuda a <span class="em">decidir</span>, no que anuncia herramientas.`}
    lead="Escribimos para gerentes y comités de dirección que necesitan entender cómo cambiar su empresa sin caer en el ruido tecnológico."
  />

  <section class="block">
    <div class="wrap">
      <div class="posts">
        {
          posts.map((post) => (
            <a href={`/ideas/${post.id}`} class="post-card fade-in">
              <span class="post-pillar">{post.data.pillar}</span>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                {fmt(post.data.pubDate)}
              </time>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Ideas aplicadas a tu empresa"
    title="¿Y si lo llevamos a tu caso concreto?"
    lead="Cada idea cobra sentido cuando se aplica a tu negocio. Empieza por un Diagnóstico Empresa Aumentada."
  />
</BaseLayout>

<style>
  .posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .post-card:hover {
    border-color: var(--teal-line);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -30px rgba(0, 80, 80, 0.35);
  }
  .post-pillar {
    font-family: var(--head);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--teal-deep);
    background: var(--teal-soft);
    border-radius: 20px;
    padding: 4px 12px;
    align-self: flex-start;
  }
  .post-title {
    font-family: var(--head);
    font-weight: 700;
    font-size: 22px;
    color: var(--tx);
    line-height: 1.2;
  }
  .post-desc {
    font-size: 15.5px;
    color: var(--tx-2);
    line-height: 1.6;
  }
  .post-date {
    font-size: 13px;
    color: var(--tx-3);
    margin-top: auto;
  }
  @media (max-width: 760px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
